{
  // Cloudflare 的部署設定。
  //
  // 這個站是純靜態的——沒有伺服器程式、沒有 build step。但 Cloudflare 已經
  // 把 Pages 併進 Workers，新建專案一律走 `npx wrangler deploy`，而那個指令
  // 需要這個檔案才知道「要部署的是一個只有靜態檔的站」。沒有它會直接失敗，
  // 錯誤訊息是找不到進入點，看不出真正的原因是缺設定。
  //
  // ★ 沒有 "main" 欄位是刻意的：那是 Worker 程式的進入點，我們沒有伺服器
  //   程式要跑。只有 assets 的設定就代表「純靜態」。
  // ★ 這個名字就是網址的第一段：<name>.<帳號子網域>.workers.dev
  //   改了它會部署出一個**新的** Worker，舊名字那個不會自動消失——
  //   要到 Workers & Pages 手動刪。好處是切換期間舊網址還活著。
  //
  //   改名之後 CORS 與 Google OAuth 的授權來源都要跟著改，否則整站
  //   `Failed to fetch`、或登入壞掉（見 meta repo 的 README Part F）。
  "name": "tutor-arthur",
  "compatibility_date": "2026-08-31",

  // 整個 repo 根目錄就是網站內容，index.html 在根目錄。
  // 附帶效果：README.md 之類的檔案也會被公開在網站上（例如 /README.md）。
  // 這裡沒有機密，所以可以接受；哪天有不該公開的檔案再改成獨立目錄。
  "assets": {
    "directory": "./",

    // 找不到對應檔案時回 404，不要自動導回 index.html。
    // 這個站沒有前端路由（畫面切換都在同一頁做完，網址不會變），
    // 導回首頁只會把「檔名打錯」偽裝成「頁面正常」，更難查。
    "not_found_handling": "404-page"
  }
}
